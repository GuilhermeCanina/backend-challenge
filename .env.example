DATABASE_URL=postgresql://wagering:wagering_dev@localhost:5432/wagering
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_CONSUMER_NAME=wager-transaction-consumer-v1
SQS_CONSUMER_ENABLED=true
SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT=60
SQS_OUTBOX_QUEUE_NAME=wager-events.fifo
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BASE_RETRY_SECONDS=1
OUTBOX_MAX_RETRY_SECONDS=300

PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_TTL_SECONDS=3600
PENDING_REFERENCE_BASE_RETRY_SECONDS=2
PENDING_REFERENCE_MAX_RETRY_SECONDS=300
